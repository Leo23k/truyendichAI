APP_ENV=production
# Vercel: set DATABASE_PATH=/tmp/database.db for an ephemeral demo database.
# Oracle/Docker: use ./data/database.db on the persistent data volume.
DATABASE_PATH=./data/database.db
MODEL_NAME=ngocdang83/HachimiMT-60-QT
DEVICE=auto
AUDIO_DIR=./data/tts_cache
CRAWLER_TIMEOUT=20
TRANSLATOR_API_URL=http://translator:7861
TTS_API_URL=http://tts:8002
MODEL_SERVICE_TIMEOUT=300
MODEL_BEAM_SIZE=2
