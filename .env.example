APP_ENV=development
# DATABASE_PATH takes precedence over DATABASE_URL when set.
DATABASE_PATH=./data/database.db
MODEL_NAME=ngocdang83/HachimiMT-60-QT
DEVICE=auto
AUDIO_DIR=./data/tts_cache
CRAWLER_TIMEOUT=20
TRANSLATOR_API_URL=http://127.0.0.1:7861
TTS_API_URL=http://127.0.0.1:8002
MODEL_SERVICE_TIMEOUT=300
MODEL_BEAM_SIZE=4
SYNC_DATABASE_PATH=./data/app.db
SYNC_AUDIO_DIR=./data/audio
SYNC_INTERVAL=60

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_KEY=your-service-key
SUPABASE_SECRET_KEY=
JSDELIVR_DATA_BASE_URL=https://cdn.jsdelivr.net/gh/Leo23k/truyendichAI-data@main/data

# B2 remains private. Set these only in server/PC worker environments.
B2_ENDPOINT=s3.ca-east-006.backblazeb2.com
B2_BUCKET=leotruyen-storage
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key

# Optional chapter read CDN. Leave unset until the Cloudflare Worker has been verified.
# Use the same high-entropy CDN_READ_TOKEN as the Cloudflare Worker secret.
CDN_BASE_URL=
CDN_READ_TOKEN=
