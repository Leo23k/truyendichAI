APP_ENV=development
# DATABASE_PATH takes precedence over DATABASE_URL when set.
DATABASE_PATH=./data/database.db
MODEL_NAME=ngocdang83/HachimiMT-60-QT
DEVICE=auto
AUDIO_DIR=./data/tts_cache
CRAWLER_TIMEOUT=20
TRANSLATOR_API_URL=http://127.0.0.1:7861
TTS_API_URL=http://127.0.0.1:8002
MODEL_SERVICE_TIMEOUT=300
MODEL_BEAM_SIZE=2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_KEY=
# Vercel: /tmp/leotruyen-data. Local PC: leave unset to use ./data.
R2_DATA_DIR=
