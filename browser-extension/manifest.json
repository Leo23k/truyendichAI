{
  "manifest_version": 3,
  "name": "Leo Truyện Gemini Companion",
  "version": "1.0.6",
  "description": "Dịch tuần tự các chương đã xếp hàng bằng tab Gemini bạn đang đăng nhập.",
  "permissions": ["activeTab", "alarms", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://leotruyen.vercel.app/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "Gemini Companion",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
